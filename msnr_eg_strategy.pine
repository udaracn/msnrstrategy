//@version=5
strategy("Malaysian SnR EG Strategy", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// --- Inputs ---
pivotLookback = input.int(10, title="Pivot Lookback")
stopLossATR = input.int(14, title="ATR Length for SL")
atrMultiplier = input.float(1.5, title="ATR Multiplier")

// --- SnR Identification ---
ph = ta.pivothigh(pivotLookback, pivotLookback)
pl = ta.pivotlow(pivotLookback, pivotLookback)

var float resLevel = na
var float supLevel = na

if not na(ph)
    resLevel := ph
if not na(pl)
    supLevel := pl

// --- Engulfing Detection ---
// Bullish Engulfing: current close > previous high and current open < previous close
isBullishEG = close > high[1] and open < close[1]
// Bearish Engulfing: current close < previous low and current open > previous close
isBearishEG = close < low[1] and open > close[1]

// --- Entry Logic ---
// Long if Bullish EG at Support
longCondition = isBullishEG and low <= supLevel * 1.001 and low >= supLevel * 0.999
// Short if Bearish EG at Resistance
shortCondition = isBearishEG and high >= resLevel * 0.999 and high <= resLevel * 1.001

// --- Volatility for SL ---
atr = ta.atr(stopLossATR)

if (longCondition)
    strategy.entry("EG Long", strategy.long)
    strategy.exit("Exit Long", "EG Long", stop=close - (atr * atrMultiplier))

if (shortCondition)
    strategy.entry("EG Short", strategy.short)
    strategy.exit("Exit Short", "EG Short", stop=close + (atr * atrMultiplier))

// Visuals
plotshape(isBullishEG, style=shape.triangleup, location=location.belowbar, color=color.green, title="Bullish EG")
plotshape(isBearishEG, style=shape.triangledown, location=location.abovebar, color=color.red, title="Bearish EG")
plot(resLevel, color=color.red, style=plot.style_linebr, title="Resistance")
plot(supLevel, color=color.green, style=plot.style_linebr, title="Support")
