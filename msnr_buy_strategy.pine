//@version=5
strategy("Malaysian SnR Buy Strategy - BTC Optimized", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// --- Inputs ---
pivotLookback = input.int(10, title="Pivot Lookback")
emaLength = input.int(200, title="Trend Filter EMA")
volSMA = input.int(20, title="Volume SMA Length")
stopLossATR = input.int(14, title="ATR Length for SL")
atrMultiplier = input.float(2.0, title="ATR Multiplier (Higher for BTC)")

// --- Indicators ---
ema = ta.ema(close, emaLength)
avgVol = ta.sma(volume, volSMA)
atr = ta.atr(stopLossATR)

// --- Support Zone Identification ---
pl = ta.pivotlow(pivotLookback, pivotLookback)

var float supBottom = na
var float supTop = na

if not na(pl)
    supBottom := low[pivotLookback]
    supTop := math.max(open[pivotLookback], close[pivotLookback])

// --- Trading Logic ---
// Trend Filter: Only Buy above EMA
uptrend = close > ema

// Rejection logic: low enters zone, close above zone
inZone = low < supTop and low > supBottom
rejection = inZone and close > supTop

// Volume Confirmation
volConfirm = volume > avgVol

longCondition = uptrend and rejection and volConfirm

strategy.risk.allow_entry_in(strategy.direction.long)

if (longCondition)
    strategy.entry("Buy", strategy.long)
    strategy.exit("Exit Buy", "Buy", stop=close - (atr * atrMultiplier))

// Plotting
plot(ema, color=color.blue, title="Trend EMA")
fill(plot(supBottom, color=na), plot(supTop, color=na), color=color.new(color.green, 90), title="Support Zone")
