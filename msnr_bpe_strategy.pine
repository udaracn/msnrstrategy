//@version=5
strategy("Malaysian SnR BPE Strategy - BTC Optimized", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// --- Inputs ---
pivotLookback = input.int(10, title="Pivot Lookback")
volSMA = input.int(20, title="Volume SMA Length")
stopLossATR = input.int(14, title="ATR Length for SL")
atrMultiplier = input.float(2.0, title="ATR Multiplier")

// --- Indicators ---
avgVol = ta.sma(volume, volSMA)

// --- SnR Identification ---
ph = ta.pivothigh(pivotLookback, pivotLookback)
pl = ta.pivotlow(pivotLookback, pivotLookback)

var float lastRes = na
var float lastSup = na

if not na(ph)
    lastRes := ph
if not na(pl)
    lastSup := pl

// --- Breakout Detection with Volume ---
breakoutLong = ta.crossover(close, lastRes) and volume > avgVol
breakoutShort = ta.crossunder(close, lastSup) and volume > avgVol

var float brokenLevel = na
var bool waitingForPullbackLong = false
var bool waitingForPullbackShort = false

if breakoutLong
    brokenLevel := lastRes
    waitingForPullbackLong := true
    waitingForPullbackShort := false

if breakoutShort
    brokenLevel := lastSup
    waitingForPullbackShort := true
    waitingForPullbackLong := false

// --- Pullback and Entry Logic ---
// Pullback = price returns to touch the broken level with rejection
pullbackLong = waitingForPullbackLong and low <= brokenLevel and close > brokenLevel and volume > avgVol[1]
pullbackShort = waitingForPullbackShort and high >= brokenLevel and close < brokenLevel and volume > avgVol[1]

// --- Volatility for SL ---
atr = ta.atr(stopLossATR)

if (pullbackLong)
    strategy.entry("BPE Long", strategy.long)
    strategy.exit("Exit Long", "BPE Long", stop=close - (atr * atrMultiplier))
    waitingForPullbackLong := false

if (pullbackShort)
    strategy.entry("BPE Short", strategy.short)
    strategy.exit("Exit Short", "BPE Short", stop=close + (atr * atrMultiplier))
    waitingForPullbackShort := false

// Plots
plot(lastRes, color=color.new(color.red, 50), title="Last Resistance")
plot(lastSup, color=color.new(color.green, 50), title="Last Support")
plot(brokenLevel, color=color.orange, style=plot.style_circles, title="Broken Level")
