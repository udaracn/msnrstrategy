//@version=5
strategy("Malaysian SnR Sell Strategy - BTC Optimized", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// --- Inputs ---
pivotLookback = input.int(10, title="Pivot Lookback")
emaLength = input.int(200, title="Trend Filter EMA")
volSMA = input.int(20, title="Volume SMA Length")
stopLossATR = input.int(14, title="ATR Length for SL")
atrMultiplier = input.float(2.0, title="ATR Multiplier (Higher for BTC)")

// --- Indicators ---
ema = ta.ema(close, emaLength)
avgVol = ta.sma(volume, volSMA)
atr = ta.atr(stopLossATR)

// --- Resistance Zone Identification ---
ph = ta.pivothigh(pivotLookback, pivotLookback)

var float resTop = na
var float resBottom = na

if not na(ph)
    resTop := high[pivotLookback]
    resBottom := math.min(open[pivotLookback], close[pivotLookback])

// --- Trading Logic ---
// Trend Filter: Only Sell below EMA
downtrend = close < ema

// Rejection logic: high enters zone, close below zone
inZone = high > resBottom and high < resTop
rejection = inZone and close < resBottom

// Volume Confirmation
volConfirm = volume > avgVol

shortCondition = downtrend and rejection and volConfirm

strategy.risk.allow_entry_in(strategy.direction.short)

if (shortCondition)
    strategy.entry("Sell", strategy.short)
    strategy.exit("Exit Sell", "Sell", stop=close + (atr * atrMultiplier))

// Plotting
plot(ema, color=color.blue, title="Trend EMA")
fill(plot(resTop, color=na), plot(resBottom, color=na), color=color.new(color.red, 90), title="Resistance Zone")
